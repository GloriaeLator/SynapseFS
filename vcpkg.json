{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "synapsefs",
  "version": "0.1.0",
  "description": "Permutation-aware, verifiable version control and virtual filesystem for neural network checkpoints",
  "homepage": "https://github.com/REPLACE_ME/synapsefs",
  "license": "MIT",
  "builtin-baseline": "REPLACE_WITH_VCPKG_COMMIT_SHA",
  "dependencies": [
    { "name": "zstd", "version>=": "1.5.5" },
    { "name": "nlohmann-json", "version>=": "3.11.3" },
    { "name": "cli11", "version>=": "2.4.1" }
  ],
  "features": {
    "tests": {
      "description": "Unit and integration tests",
      "dependencies": [ { "name": "catch2", "version>=": "3.5.0" } ]
    }
  },
  "default-features": [ "tests" ],
  "overrides": []
}
